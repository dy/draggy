{
  "name": "draggy",
  "version": "2.0.5",
  "description": "A tiny, dependency-free draggable for the web",
  "type": "module",
  "main": "draggy.js",
  "module": "draggy.js",
  "exports": {
    ".": "./draggy.js"
  },
  "files": [
    "draggy.js",
    "draggy.min.js",
    "draggy.min.js.map"
  ],
  "scripts": {
    "build": "esbuild draggy.js --bundle --minify --format=esm --sourcemap --outfile=draggy.min.js",
    "test": "node --test test/*.test.js",
    "check": "npm test && npm run build",
    "watch": "esbuild draggy.js --bundle --format=esm --sourcemap --outfile=draggy.min.js --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dy/draggy.git"
  },
  "keywords": [
    "draggable",
    "drag-and-drop",
    "pointer-events",
    "drag",
    "drop"
  ],
  "author": "Dmitry Iv",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dy/draggy/issues"
  },
  "homepage": "https://dy.github.io/draggy/",
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
